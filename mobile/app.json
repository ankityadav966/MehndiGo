{
  "expo": {
    "name": "mehendigoo",
    "slug": "mehendigoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mehendigoo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sonuy123.mehendigoo",
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF4D6D"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}