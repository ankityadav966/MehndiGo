{
  "expo": {
    "name": "MehdiGo",
    "slug": "sonu-yadav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mehendigoo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sonuy123.mehendigoo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share mehndi designs.",
          "cameraPermission": "The app accesses your camera to let you take photos of mehndi designs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The app accesses your location to share coordinates with artists."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF4D6D"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "137cc401-a02c-4f2e-9e40-1f7e5427432d"
      }
    },
    "owner": "sonuyadav87s-team"
  }
}
