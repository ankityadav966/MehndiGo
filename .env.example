# MehandiGo - Global Configuration Parameters Template
# Copy this file to '.env' and specify active credentials. Do NOT commit the '.env' file.

# 1. Server Setup
NODE_ENV=production
PORT=8000
JWT_SECRET=super_secret_jwt_generation_hash_key_123

# 2. Database Connection (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=ankit
DB_PASS=123456
DB_NAME=mehndigo_prod_db

# 3. Third Party Services Integrations
# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxx

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=mehendigo_media
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxx

# Firebase Cloud Messaging Credentials Path
GOOGLE_APPLICATION_CREDENTIALS=/usr/src/app/firebase-service-account.json
firebase_key=xxxxxxxxxxxxxxxxxxx
